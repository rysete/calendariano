# Root .gitignore for escala-web-editor

# Node/Frontend
node_modules/
dist/
dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.local

# Python/Backend
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
backend/uploads/*
!backend/uploads/.gitkeep

# Environments
.env
.env.local
.env.*.local
backend/google_credentials.json
backend/google_credential.json
backend/google_token.json
backend/google_oauth_states.json
credentials.json
token.pickle

# Flatpak local build artifacts
.flatpak-build/
.flatpak-builder/
.flatpak-repo/

# Backup do diretorio backend/calendars que era root-owned (Docker bind mount)
backend/.calendars-root-bkp/

# Editor/System
.vscode/
.idea/
.DS_Store
*.swp
*.swo
